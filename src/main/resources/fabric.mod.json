{
	"schemaVersion": 1,
	"id": "waylight",
	"version": "${version}",
	"name": "Waylight",
	"description": "Client-side hip lantern mod for Minecraft that adds a toggleable personal light using vanilla lantern models and dynamic lights.",
	"authors": [
		"soradotwav"
	],
	"contact": {
		"sources": "https://github.com/soradotwav/waylight"
	},
	"license": "CC0-1.0",
	"icon": "assets/waylight/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.soradotwav.Waylight"
		],
		"client": [
			"com.soradotwav.WaylightClient"
		],
		"modmenu": [
			"com.soradotwav.waylight.config.WaylightModMenuCompat"
		]
	},
	"mixins": [
		"waylight.mixins.json",
		{
			"config": "waylight.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*",
		"lambdynlights": ">=4.9.1+1.21.11"
	},
	"suggests": {
		"modmenu": "*"
	}
}

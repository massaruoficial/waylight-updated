{
  "schemaVersion": 1,
  "id": "waylight",
  "version": "1.0.0-v17.8+26.2",
  "name": "Waylight",
  "description": "Client-side virtual lantern for Minecraft: carry a configurable vanilla lantern on your hip or in hand with dynamic light, no inventory item required. Includes optional Punchy and Iris shader compatibility.",
  "authors": [
    "soradotwav"
  ],
  "license": "LGPL-3.0-or-later",
  "icon": "assets/waylight/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.soradotwav.Waylight"
    ],
    "client": [
      "com.soradotwav.WaylightClient"
    ],
    "modmenu": [
      "com.soradotwav.waylight.integration.WaylightModMenuCompat"
    ]
  },
  "mixins": [
    "waylight.mixins.json",
    {
      "config": "waylight.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*",
    "lambdynlights": ">=4.12.0+26.2"
  },
  "suggests": {
    "modmenu": "*"
  }
}
